@page "/"

<PageTitle>&lt;DevMemo/&gt;</PageTitle>


<div class="page-container">
    <div class="logo-container">
        <img src="/images//DevMemo-logo.png" />
    </div>

    <div class="game-container">
        <div class="gameboard-container">
            @* New key creates a new GameBoard instance *@
            <GameBoard @key="gameNumber" OnGameFinished="@FinishGame" />
        </div>

        @if (gameState != GameState.Playing)
        {
            <div class="game-overlay" />
        }

        @if (gameState == GameState.Welcome)
        {
            <div class="game-modal">
                <h2>Welcome to &lt;DevMemo/&gt;</h2>
                <p>Match the icons. Master the stack.</p>

                <button class="game-btn" @onclick="StartGame">Play</button>
            </div>
        }
        else if (gameState == GameState.Finished)
        {
            <div class="game-modal">
                <h2>Well played!</h2>
                <p>Your results:</p>

                <button @onclick="() => PlayAgain(GameState.Playing)" class="game-btn">Play Again</button>
                <button @onclick="() => PlayAgain(GameState.Welcome)" class="quit-btn">Quit</button>
            </div>
        }
    </div>
</div>

@code {
    // State controlling which view to display
    private GameState gameState = GameState.Welcome;
    // Used as a key to create a new GameBoard instance
    private int gameNumber = 0;

    private enum GameState
    {
        Welcome,
        Playing,
        Finished
    }

    private void StartGame()
    {
        gameState = GameState.Playing;
    }

    private void FinishGame()
    {
        gameState = GameState.Finished;
    }

    // Resets the game board and switches to the selected game state
    private void PlayAgain(GameState nextState)
    {
        gameNumber++;
        gameState = nextState;
    }
}