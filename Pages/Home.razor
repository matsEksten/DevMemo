@page "/"

<PageTitle>&lt;DevMemo/&gt;</PageTitle>


<div class="page-container">
    <div class="logo-container">
        <img src="/images//DevMemo-logo.png" />
    </div>

    <div class="game-container">
        <div class="gameboard-container">
            <GameBoard />
        </div>

        @if (gameState != GameState.Playing)
        {
            <div class="game-overlay" />
        }

        @if (gameState == GameState.Welcome)
        {
            <div class="game-modal">
                <h2>Welcome to &lt;DevMemo/&gt;</h2>
                <p>Match the icons. Master the stack.</p>

                <button class="game-btn" @onclick="StartGame">Play</button>
            </div>
        }
        else if (gameState == GameState.Finished)
        {
            <div class="game-modal">
                <h2>Well played!</h2>
                <p>Your results...</p>

                <button>Play Again</button>
                <button>Quit</button>
            </div>
        }
    </div>
</div>

@code {
	private GameState gameState = GameState.Welcome;

	private enum GameState
	{
		Welcome,
		Playing,
		Finished
	}

	private void StartGame()
	{
		gameState = GameState.Playing;
	}
}