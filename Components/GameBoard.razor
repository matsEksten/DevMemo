@* Sends each card to GameCard component and establish click event to the gameManager instance *@
@foreach (Card card in cards)
{
	<GameCard CardData="card" OnCardClicked="() => gameManager.SelectCard(card)" />
}

@code {
	private List<Card> cards = new()
	{
		new Card(1, 1, "images/cards/react-original.svg"),
		new Card(2, 1, "images/cards/react-original.svg")
	};

	// Shared game manager for all cards on the board.
	private GameManager gameManager = new GameManager();
}


