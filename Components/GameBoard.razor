<div class="gameboard-container">
	@* Displays game statistics from the shared GameManager. *@
	<GameStats Attempts="gameManager.Attempts" Pairs="gameManager.Pairs" />

	@* Passes each card to GameCard and connects its click event to GameManager. *@
	<div class="gameboard-grid">
		@foreach (Card card in cardSet.Cards)
		{
			<GameCard CardData="card" OnCardClicked="() => HandleCardClick(card)" />
		}
	</div>
</div>



@code {
	private CardSet cardSet = new CardSet();

	// Shared game manager for all cards on the board.
	private GameManager gameManager = new GameManager();

	[Parameter] public EventCallback OnGameFinished { get; set; }
	

	private async Task HandleCardClick(Card card)
	{
		await gameManager.SelectCard(card);

		if (gameManager.Pairs == 8)
		{
			await OnGameFinished.InvokeAsync();
		}
	}
}


